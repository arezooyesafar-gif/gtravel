<form id="search_tour" class="filter-form" data-url="/ajax_dest" onsubmit="return validateEmpty()" method="get"
      action="{% url 'search-result' %}"
      style="text-align: center">
    {% csrf_token %}
    <div class="row">
        <div class="col-lg-12 search_f_">
            <p class="search_label_">مقصد را وارد کنید</p>
            {{ Search.DestCountry }}
            <div id="defualt_dest" style="display: none">
                <li class="dest_item" onclick="addcity('آنتالیا')">آنتالیا</li>
                <li class="dest_item" onclick="addcity('مسکو')">مسکو</li>
                <li class="dest_item" onclick="addcity('سنت پترزبورگ')">سنت پترزبورگ</li>
                <li class="dest_item" onclick="addcity('استانبول')">استانبول</li>
                <li class="dest_item" onclick="addcity('قطر')">قطر</li>
            </div>
            <div id="list_dest" style="display: none;">
                <script>
                    function addcity(city) {
                        document.getElementById('id_DestCountry').value = city
                        document.getElementById('list_dest').style.display = 'none'
                        document.getElementById('defualt_dest').style.display = 'none'
                    }
                </script>
            </div>
        </div>
{#        <div class="col-lg-12 search_f_">#}
{#            <p class="search_label_">روزهای اقامت را وارد کنید</p>#}
{#            <span class="plus">+</span>#}
{#            {{ Search.NightCount }}#}
{#            <span class="minus">-</span>#}
{#        </div>#}
{#        <div class="col-lg-12 search_f_">#}
{#            <p class="search_label_">تاریخ</p>#}
{#            {{ Search.StartDate }}#}
{#        </div>#}
        <div class="col-lg-12">
            <button type="submit" onclick='convertDate()' class="submit-search">
                <i class="fa fa-search"></i>
                جستجو تور
            </button>
        </div>
    </div>
</form>
<script>
    function hide_search_box() {

    }

    $(document).ready(function () {
        $('.minus').click(function () {
            var $input = $(this).parent().find('input');
            var count = parseInt($input.val()) - 1;
            count = count < 1 ? 1 : count;
            $input.val(count);
            $input.change();
            return false;
        });
        $('.plus').click(function () {
            var $input = $(this).parent().find('input');
            $input.val(parseInt($input.val()) + 1);
            $input.change();
            return false;
        });
        $('#id_DestCountry').click(function () {
            $("#defualt_dest").show();
        });
        $(document).mouseup(function(e){
            var container = $("#defualt_dest");
            if(!container.is(e.target) && container.has(e.target).length === 0){
            container.hide();
            }
        });
        $("#id_DestCountry").keyup(function () {
            document.getElementById('list_dest').style.display = ''
            var url = $("#search_tour").attr("data-url");
            var DestCountry = $(this).val();
            $.ajax({
                url: url,
                data: {
                    'DestCountry': DestCountry
                },
                success: function (data) {
                    $("#list_dest").html(data);
                }
            })
        });
    });
</script>