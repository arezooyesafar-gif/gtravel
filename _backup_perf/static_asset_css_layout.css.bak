ottom:4px;font-size:17px}.rating-box{margin-top:27px}.user-comments{padding:15px;border-radius:15px}i.cm-item-user{font-size:18px;color:#ccc}i.cm-item-date{font-size:18px;color:#008cba;padding-left:7px}p.user-rate-headline{text-align:left;margin-bottom:0}p.user-rate{text-align:left;color:#008cba}.cooments_message,p.message-body{text-align:justify}.cooments_message{font-family:IranSans;font-size:14px;line-height:28px;padding:15px}.comment-reply{display:none;margin-top:20px}button.comments-replay{border:none;background:0 0;color:#008cba}button.reply-btn{background:#ffc107;border:none;margin-top:10px;width:100%;line-height:32px;font-family:YekanBold;border-radius:10px}p.success-send{text-align:center;background:#80deb2;line-height:34px;border-radius:10px;display:none}.cm-reply-box{margin-right:40px;background:#daf1ff;padding:15px;border-radius:10px}button.btn-primary-comment:hover,button.reply-btn:hover{background:#008cba;color:#fff;transition:.3s ease-in-out}p.invalid-data-cm{background:#ff7a07;text-align:center;border-radius:5px;color:#fff;display:none}span.attention{padding-right:10px;color:red;font-size:12px}.post_page_body img{border-radius:40px;padding-top:15px;padding-bottom:15px}.accordion-button.collapsed img{width:30px;padding-left:5px}.article-body img{border-radius:25px}.row.info-button{margin-top:0!important}p.social-head-post{position:absolute;right:15px;top:-13px;background:#fff;padding:0 15px;border-radius:10px;border:1px solid #ccc;line-height:30px;font-size:14px;color:#225ac1;font-weight:700;font-family:YekanBold!important;box-shadow:0 0 5px #ccc}.spacial_baget-h p,a.visa-link-mobile{color:#fff;text-align:center;position:relative}i.post-social:hover{color:#225ac1}p#success-link-copy{margin-bottom:0;background:#c5f1dd;border-radius:10px;display:none}a.visa-link-mobile{display:block;background:#008cba;font-family:iransans;border-bottom: 1px solid #ffffff38;line-height:45px;z-index:100;top:63px}::-webkit-scrollbar{width:5px}::-webkit-scrollbar-track{-webkit-box-shadow:inset 0 0 0 rgba(0,0,0,.3);border-radius:10px}::-webkit-scrollbar-thumb{border-radius:10px;background:#ccc;-webkit-box-shadow:inset 0 0 0 rgba(0,0,0,.5)}.hotel_booking_rate_::after{content:'';position:absolute;width:20px;height:20px;left:10px;top:3px;background:url('/static/asset/css/images/BOOKING.png') center center/20px 20px}span.no.change{color:#008cba;padding-right:5px;font-size:12px}.new_pos_post{position:absolute;bottom:435px;width:280px}.spacial_baget-h{position:absolute;top:16px;right:-8px;z-index:10;display:flex;align-items:center;justify-content:center;gap:4px;height:28px;background:#225ac1;border-radius:24px 12px 0 24px;padding:8px}.spacial_baget-h::before{content:"";width:16px;height:16px;flex:0 0 auto;background:url("data:image/svg+xml;base64,") no-repeat center/contain}.spacial_baget-h p{padding-right:0;transform:none;width:auto;top:0;margin:0;white-space:nowrap;color:#fff;font-size:14px}.cat-img.city-list{height:125px}p.title-cat.hotel_list.en-title{color:#999;font-size:13px!important;text-transform:uppercase;direction:ltr;}.categories-box{border:1px solid #e0e0e0;border-radius:8px;background:#fff;max-height:250px;overflow-y:auto;padding:10px}.categories-box .checkbox-group{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin:0;padding:0;list-style:none}.categories-box label{display:flex;align-items:center;gap:8px;padding:6px 10px;border-radius:6px;cursor:pointer;transition:all .2s;margin:0;font-weight:normal}.categories-box label:hover{background-color:#f0f0f0}.categories-box input[type="checkbox"]{width:16px;height:16px;margin:0;cursor:pointer;flex-shrink:0}.categories-box input[type="checkbox"]:checked+span{color:#225ac1;font-weight:500}.category-scroll{max-height:220px;overflow-y:auto;border:1px solid #ddd;padding:10px;border-radius:8px;background:#fff}.category-scroll ul{list-style:none;padding:0;margin:0}.category-scroll li{margin-bottom:8px;display:flex;align-items:center;gap:8px}.category-scroll input[type="checkbox"]{width:16px;height:16px;cursor:pointer}.tour-title-breadcrumb-row{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:30px;flex-direction:row;background:#ffffff00;padding:10px 20px;border-bottom:1px solid #6c757d3d}.tour-page-title-box{flex:0 0 auto}.tour-page-title{margin:0!important;padding-right:0!important}.tour-breadcrumb-ui{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin:0;padding:0;font-family:'IranSans';font-size:16px;line-height:1.8;color:#060606;flex-direction:row;width:auto}.tour-breadcrumb-ui a{display:flex;align-items:center;gap:6px;color:#060606;text-decoration:none}.tour-breadcrumb-ui a:hover{color:#0d6efd;text-decoration:none}.tour-breadcrumb-ui span{color:#060606}.tour-breadcrumb-ui .breadcrumb-separator{color:#060606;font-size:16px;line-height:1}.breadcrumb-home-link img{width:20px;height:20px;display:inline-block}@media(max-width:991px){.tour-title-breadcrumb-row{align-items:flex-start;flex-direction:column;gap:8px;margin-bottom:24px;padding:10px 14px}.tour-breadcrumb-ui{font-size:12px;gap:4px}.tour-breadcrumb-ui .breadcrumb-separator{font-size:13px}}.tour-detail-breadcrumb-ui{width:100%;display:flex;align-items:center;justify-content:flex-start;flex-wrap:wrap;gap:7px;margin:0 0 12px;padding:0 0 10px;border-bottom:1px solid #e5e5e5;font-family:'IranSans';font-size:13px;line-height:1.8;color:#555;direction:rtl}.tour-detail-breadcrumb-ui a{display:flex;align-items:center;gap:5px;color:#555;text-decoration:none}.tour-detail-breadcrumb-ui a:hover{color:#0d6efd;text-decoration:none}.tour-detail-breadcrumb-ui span{color:#555}.tour-detail-breadcrumb-ui .breadcrumb-separator{color:#aaa;font-size:13px;line-height:1}.tour-detail-breadcrumb-ui .breadcrumb-home-link img{width:18px;height:18px;display:inline-block}@media(max-width:991px){.tour-detail-breadcrumb-ui{font-size:12px;gap:5px;margin-bottom:10px;padding-bottom:8px}}#_tourEmptyState input,#_tourEmptyState button,#_tourEmptyState h2,#_tourEmptyState p,#_tourEmptyState span,#_ti_msg{font-family:'IranSans'!important;}@media(max-width:768px){#_es_icon_div{display:none!important;}}.post-toc-box{border:1px solid #e2e2e2;border-radius:8px;margin:20px 0;overflow:hidden;background:#fff;}.post-toc-header{background:#0066cc;color:#fff;padding:12px 18px;display:flex;justify-content:space-between;align-items:center;cursor:pointer;font-weight:bold;font-family:'IranSans',Tahoma,Arial,sans-serif;}.post-toc-body{max-height:2000px;overflow:hidden;padding:15px 20px;transition:max-height .3s ease,padding .3s ease;}.post-toc-body.collapsed{max-height:0;padding-top:0;padding-bottom:0;}.post-toc-list{list-style:none;margin:0;padding:0;}.post-toc-list li{padding:6px 0;border-bottom:1px dashed #eee;}.post-toc-list li:last-child{border-bottom:none;}.post-toc-list li.toc-h3{padding-right:20px;font-size:.95em;}.post-toc-list a{color:#333;text-decoration:none;}.post-toc-list a:hover{color:#f4bd0e;}.hotel-col-menu-1,.hotel-col-menu-2,.hotel-col-menu-3,.hotel-col-menu-4{left:0;transition:left .1s ease-in-out;width:100%}.hotel-sub-menu-1,.hotel-sub-menu-2,.hotel-sub-menu-3,.hotel-sub-menu-4{position:relative;left:-100%;transition:left .3s ease-in-out;top:-10px;border-right:1px solid #e8e8e8;padding-right:10px}.offcanvas-hotel-sub-menu{position:absolute;top:10px;width:100%;left:100%;transition:left .3s ease-in-out}.offcanvas-hotel-city-menu{position:absolute;width:100%;top:20px;right:100%;transition:right .3s ease-in-out}.blog_search_form_{display:flex;align-items:center;margin-bottom:20px;border:1px solid #e8e8e8;border-radius:5px;overflow:hidden}.blog_search_input_{flex:1;border:none;outline:none;padding:10px 15px;font-family:IranSans;font-size:14px}.blog_search_btn_{border:none;background:#ff9800;color:#fff;padding:10px 20px;cursor:pointer}.blog_search_empty_{font-family:IranSans;color:#777;padding:15px 0}._all_post_list_header.search-active::after{display:none}

/* ===========================================================================
   رفع اسکرول افقی موبایل
   .account (جعبهٔ دکمهٔ تلفن در هدر) کلاس col-sm-12 دارد که عرضش را ۱۰۰٪ می‌کند،
   و همزمان زیر ۹۵۰ پیکسل position:absolute با left:90px می‌گیرد. نتیجه: جعبه از
   ۹۰ پیکسل شروع می‌شود ولی همچنان ۱۰۰٪ عرض دارد، یعنی دقیقاً ۹۰ پیکسل از صفحه
   بیرون می‌زند و کل صفحه کمی چپ‌وراست اسکرول می‌خورد. این روی همهٔ صفحات بود.
   با بستن لبهٔ راست، جعبه داخل صفحه می‌ماند؛ چون محتوایش text-align:left است
   جای دیدنی‌اش عوض نمی‌شود.
   =========================================================================== */
@media only screen and (max-width:950px){
    /* انتخابگر دوکلاسی تا از هر قانون تک‌کلاسیِ دیرتر (مثل .col-sm-12
       بوت‌استرپ که بعد از این فایل لود می‌شود) قوی‌تر باشد. */
    .account.col-sm-12,.account{right:0;width:auto;max-width:100%}
}

/* دکمهٔ شناور «محاسبه اقساط» z-index:90 داشت و نوار چسبانِ تب‌های تور
   z-index:999، پس هر جا به هم می‌رسیدند نوار روی دکمه می‌افتاد. دکمه باید
   همیشه بالاتر باشد چون شناور و همیشه در دسترس است. */
#calc_btn,div#calc_btn,#calc_btn_mobile{z-index:1001}

/* هدر position:fixed با width:100% است ولی ۴۲۴ پیکسل می‌شد در حالی که صفحه
   ۴۱۴ بود، پس ۱۰ پیکسل به چپ بیرون می‌زد و کل سایت افقی اسکرول می‌خورد
   (سایت RTL است، برای همین سرریز به چپ می‌رفت و در نگاه اول دیده نمی‌شد).
   به‌جای حدس زدن منبع آن ۱۰ پیکسل، هر دو لبه لنگر می‌شود: با left:0 و
   right:0 و width:auto هدر دقیقاً اندازهٔ صفحه می‌ماند، هر padding یا
   border ای که داشته باشد. border-box هم اضافه شده که padding داخل عرض
   حساب شود. ظاهر عوض نمی‌شود چون هدر از اول تمام‌عرض بوده. */
.main_header{box-sizing:border-box;left:0;right:0;width:auto}

/* ===========================================================================
   جعبهٔ «دریافت مشاوره و رزرو تور» + فیلد ثبت شماره
   .contact-banner ارتفاع ثابت 150px داشت که با اضافه شدن فرم جا نمی‌شد.
   محتوا حالا ارتفاع را تعیین می‌کند و همان حداقل قبلی حفظ می‌شود تا در
   صفحاتی که فرم ندارند ظاهر عوض نشود.
   =========================================================================== */
.contact-banner{height:auto;min-height:150px;box-sizing:border-box}

.reseve-lead{margin:12px 0 0;display:flex;flex-direction:column;gap:8px}
.reseve-lead-input{width:100%;box-sizing:border-box;border:none;border-radius:10px;
    padding:10px 14px;font-family:iransans!important;font-size:14px;color:#1a1d24;
    background:#fff;text-align:right;direction:rtl;outline:none}
.reseve-lead-input::placeholder{color:#9aa3b0}
.reseve-lead-input:focus{box-shadow:0 0 0 2px #ffc107}
.reseve-lead-btn{width:100%;border:none;border-radius:10px;padding:10px 14px;
    background:#ffc107;color:#3a2c00;font-family:iransans!important;font-size:14px;
    font-weight:700;cursor:pointer;transition:filter .15s}
.reseve-lead-btn:hover{filter:brightness(.95)}
.reseve-lead-btn:disabled{opacity:.65;cursor:default}
.reseve-lead-msg{margin:0;font-family:iransans!important;font-size:12.5px;
    color:#fff;display:none;line-height:1.7}
.reseve-lead-msg.is-error{color:#ffd9d4}

/* ===========================================================================
   نظرات مسافران در صفحهٔ تور کشور
   =========================================================================== */
.tour-reviews{margin:34px 0 10px}
.tour-reviews-head{display:flex;align-items:center;justify-content:space-between;
    gap:14px;flex-wrap:wrap;margin-bottom:16px}
.tour-reviews-title{font-family:iransans!important;font-size:19px;font-weight:700;
    color:#1a1d24;margin:0}
.tour-reviews-cta{display:inline-block;background:#fff;border:1px solid #1d5cad;
    color:#1d5cad!important;border-radius:10px;padding:9px 16px;font-size:13.5px;
    font-weight:600;font-family:iransans!important;text-decoration:none!important;
    white-space:nowrap;transition:background .15s,color .15s}
.tour-reviews-cta:hover{background:#1d5cad;color:#fff!important}

.tour-reviews-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.tour-review{background:#fff;border:1px solid #e5e9f0;border-radius:14px;
    padding:16px 18px;display:flex;flex-direction:column;gap:10px}
.tour-review-top{display:flex;align-items:center;gap:10px}
.tour-review-avatar{width:38px;height:38px;flex:0 0 38px;border-radius:50%;
    background:#e6f1fb;color:#1d5cad;display:flex;align-items:center;
    justify-content:center;font-family:iransans!important;font-size:17px;font-weight:700}
.tour-review-who{display:flex;flex-direction:column;gap:2px;min-width:0}
.tour-review-author{font-family:iransans!important;font-size:14px;font-weight:700;
    color:#1a1d24;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tour-review-stars{color:#f5a623;font-size:13px;line-height:1;letter-spacing:1px}
.tour-review-text{font-family:iransans!important;font-size:13.5px;line-height:2.1;
    color:#4a5162;margin:0;flex:1 1 auto}
.tour-review-foot{display:flex;align-items:center;gap:10px;font-family:iransans!important;
    font-size:11.5px;color:#9aa3b0}
.tour-review-src{margin-inline-start:auto}

@media (max-width:991px){
    .tour-reviews-grid{grid-template-columns:1fr}
    .tour-reviews-title{font-size:17px}
    .tour-reviews-cta{width:100%;text-align:center}
}

.tour-review-src-link{display:inline-flex;align-items:center;gap:4px;color:#1d5cad!important;text-decoration:none!important;font-weight:600;border-bottom:1px dashed #b9d0ea;padding-bottom:1px;transition:color .15s,border-color .15s}
.tour-review-src-link:hover{color:#0f3f7d!important;border-bottom-color:#1d5cad}
.tour-review-src-link svg{flex:0 0 auto;opacity:.85}

.travelogue-banner{margin:16px 0 0}
.tvb-card{display:flex;align-items:center;gap:24px;width:100%;box-sizing:border-box;
    padding:18px 26px;border:1px solid #dfeaf7;border-radius:26px;background:#f4f9ff;
    box-shadow:0 1px 2px rgba(16,48,90,.03);text-decoration:none!important;
    transition:background .15s,border-color .15s}
.tvb-card:hover{background:#eef5ff;border-color:#cfe1f5}
.tvb-icon{flex:0 0 auto;width:63px;height:63px;border-radius:50%;background:#e4effb;
    display:flex;align-items:center;justify-content:center;color:#0a4fa3}
.tvb-text{flex:1 1 auto;min-width:0;display:flex;flex-direction:column;gap:8px}
.tvb-title{font-family:iransans!important;font-size:22px;font-weight:800;color:#0d2f57;
    line-height:1.3;margin:0}
.tvb-desc{font-family:iransans!important;font-size:14.5px;font-weight:500;color:#55708f;
    line-height:1.9;margin:0}
.tvb-cta{flex:0 0 auto;display:flex;align-items:center;gap:10px;font-family:iransans!important;
    font-size:16px;font-weight:700;color:#0a66d6;white-space:nowrap}
.tvb-card:hover .tvb-cta{color:#084b9e}
.tvb-cta svg{flex:0 0 auto}

@media (max-width:991px){
    .travelogue-banner{margin:0 12px}
    .tvb-card{gap:14px;padding:16px 18px;border-radius:20px;flex-wrap:wrap}
    .tvb-icon{width:48px;height:48px}
    .tvb-icon svg{width:28px;height:28px}
    .tvb-title{font-size:17px}
    .tvb-desc{font-size:13px;line-height:1.9}
    .tvb-cta{width:100%;justify-content:center;font-size:14.5px;
        border-top:1px solid #dfeaf7;padding-top:12px;margin-top:2px}
    .tvb-cta svg{width:20px;height:14px}
}

@media (min-width:992px){
    .tour-listing-layout{align-items:flex-start}
    .tour-listing-sidebar{position:relative;align-self:stretch}
    #sidebar.sticky_menu,
    #sidebar.sticky_menu.fixed_pos,
    #sidebar.sticky_menu.new_pos,
    #sidebar.sticky_menu.new_pos_side{position:sticky!important;top:70px;bottom:auto;
        left:auto;right:auto;width:auto;max-height:none;overflow:visible}
}

.order-container .form-title.headline{color:#1b1b1b!important;margin-bottom:6px}
.order-container .inform{font-size:15px;line-height:2;margin-bottom:4px}
.oi-note{color:#6b7280;font-size:13px;line-height:2;margin-bottom:22px}
.oi-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;
    text-align:right;margin:0 auto 26px;max-width:780px}
.oi-item{background:#f7f9fb;border:1px solid #e6ecf1;border-radius:12px;padding:12px 16px;
    display:flex;flex-direction:column;gap:6px;min-width:0}
.oi-item-wide{grid-column:1/-1}
.oi-label{color:#6b7280;font-size:12.5px;font-family:iransans}
.oi-value{color:#111;font-size:14px;font-weight:700;font-family:iransans;line-height:1.9;
    word-break:break-word}
.oi-code{letter-spacing:1px;color:#0575b4}
.oi-badge{display:inline-block;background:#f6d055;color:#000;border-radius:8px;
    padding:2px 12px;font-size:13px}
.oi-chip{display:inline-block;background:#fff;border:1px solid #e6ecf1;border-radius:8px;
    padding:2px 10px;margin:2px 0 2px 6px;font-size:13px;font-weight:400}
.oi-tour-link{color:#0575b4!important;text-decoration:none}
.oi-tour-link:hover{text-decoration:underline}
.oi-actions{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;align-items:center}
.oi-link-2{background:#fff;border:1px solid #d8e2ea;padding:5px 15px;border-radius:10px;
    color:#0575b4!important;text-decoration:none}
@media (max-width:767px){
    .order-container{width:100%;padding:24px 16px;margin:30px auto 40px}
    .oi-grid{grid-template-columns:1fr}
}
